{
  "name": "reqstorm",
  "version": "0.2.0",
  "description": "Complete API testing platform MCP server with 14 tools: performance testing (benchmark, load, stress, spike, soak, smoke, A/B compare, profile), functional validation, multi-step workflow chains, OpenAPI contract checking, fuzzing, security scanning, and regression detection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/looph0le/ReqStorm.git"
  },
  "bin": {
    "reqstorm": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "performance",
    "load-testing",
    "api",
    "benchmark",
    "stress-test",
    "soak-test",
    "spike-test",
    "validation",
    "fuzzing",
    "contract-testing",
    "security",
    "workflow",
    "regression"
  ],
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "autocannon": "^8.0.0",
    "jsonpath-plus": "^10.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
